<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="odev3son.HavaDurumu"
             Title="Hava Durumu"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Şehir Ekle"
                     Clicked="AddSchir_Clicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Spacing="10" Padding="15">

            <!-- Bilgi Mesajı -->
            <Frame BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1A1A1A}"
                   Padding="15"
                   CornerRadius="8"
                   HasShadow="False">
                <Label Text="Meteoroloji Genel Müdürlüğü verilerini gösterir. Şehir eklemek için yukarıdaki butona tıklayın."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                       HorizontalTextAlignment="Center"/>
            </Frame>

            <!-- Şehir Listesi -->
            <CollectionView x:Name="lstSchirler"
                            ItemsSource="{Binding Schirler}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="0,0,0,10"
                               Padding="10"
                               BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"
                               CornerRadius="8"
                               HasShadow="True"
                               BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">

                            <VerticalStackLayout Spacing="8">

                                <!-- Başlık ve Butonlar -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">

                                    <Label Grid.Column="0"
                                           Text="{Binding SchirAdi}"
                                           FontSize="18"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"/>

                                    <Button Grid.Column="1"
                                            Text="Yenile"
                                            FontSize="12"
                                            Padding="10,5"
                                            CornerRadius="5"
                                            BackgroundColor="{AppThemeBinding Light=#2196F3, Dark=#1976D2}"
                                            TextColor="#FFFFFF"
                                            Clicked="Update_Clicked"
                                            CommandParameter="{Binding}"/>

                                    <Button Grid.Column="2"
                                            Text="Sil"
                                            FontSize="12"
                                            Padding="10,5"
                                            CornerRadius="5"
                                            BackgroundColor="{AppThemeBinding Light=#F44336, Dark=#D32F2F}"
                                            TextColor="#FFFFFF"
                                            Clicked="Remove_Clicked"
                                            CommandParameter="{Binding}"/>
                                </Grid>

                                <!-- WebView Başlıkları -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="Anlık Durum"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"/>

                                    <Label Grid.Column="1"
                                           Text="5 Günlük Tahmin"
                                           FontSize="13"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"/>
                                </Grid>

                                <!-- WebView'lar -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <WebView Grid.Column="0"
                                             Source="{Binding BugunUrl}"
                                             HeightRequest="250"
                                             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"/>

                                    <WebView Grid.Column="1"
                                             Source="{Binding BesGunUrl}"
                                             HeightRequest="250"
                                             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1A1A1A}"/>
                                </Grid>

                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <!-- Boş Liste -->
                <CollectionView.EmptyView>
                    <VerticalStackLayout HorizontalOptions="Center"
                                         VerticalOptions="Center"
                                         Padding="40"
                                         Spacing="15">
                        <Label Text="🏙️"
                               FontSize="50"
                               HorizontalOptions="Center"/>

                        <Label Text="Henüz şehir eklenmemiş"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#CCCCCC}"
                               HorizontalOptions="Center"/>

                        <Label Text="Yukarıdaki 'Şehir Ekle' butonuna tıklayın"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#999999, Dark=#999999}"
                               HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>