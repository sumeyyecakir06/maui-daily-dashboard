<?xml version="1.0" encoding="UTF-8"?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:odev3son"
       x:Class="odev3son.AppShell"
       Title="BSM322 Ödev 3"
       FlyoutBehavior="Flyout"
       Shell.FlyoutBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
       Shell.BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#121212}"
       Shell.ForegroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
       Shell.TitleColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}">

    <Shell.Resources>
        <ResourceDictionary>
            <!-- 1. Menü Elemanları için Genel Stil -->
            <Style TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=Black, Dark=White}" />
            </Style>

            <!-- 2. Header (Profil) Kısmı İçin Özel Stiller -->
            <Style x:Key="HeaderNameStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=White}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="HeaderIdStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#F0F0F0, Dark=#E0E0E0}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>

            <Style x:Key="HeaderSchoolStyle" TargetType="Label">
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#E8E8E8, Dark=#CCCCCC}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="HorizontalOptions" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Shell.Resources>

    <Shell.FlyoutHeader>
        <Border BackgroundColor="{AppThemeBinding Light=#6200EE, Dark=#1E1E1E}"
                Padding="20"
                HeightRequest="180">
            <VerticalStackLayout Spacing="10"
                                 HorizontalOptions="Center"
                                 VerticalOptions="Center">
                <Frame BackgroundColor="{AppThemeBinding Light=White, Dark=#2C2C2C}"
                       BorderColor="{AppThemeBinding Light=White, Dark=#555555}"
                       CornerRadius="40"
                       HasShadow="True"
                       Padding="2"
                       WidthRequest="80"
                       HeightRequest="80">
                    <Image Source="profile.png" 
                           Aspect="AspectFill" 
                           WidthRequest="76" 
                           HeightRequest="76"/>
                </Frame>

                <Label Text="Sümeyye Çakır" 
                       Style="{StaticResource HeaderNameStyle}"/>
                <Label Text="23010310021" 
                       Style="{StaticResource HeaderIdStyle}"/>
                <Label Text="Bartın Üniversitesi" 
                       Style="{StaticResource HeaderSchoolStyle}"/>
            </VerticalStackLayout>
        </Border>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Ana Sayfa" Icon="home.png">
        <ShellContent Title="Ana Sayfa" 
                      ContentTemplate="{DataTemplate local:HomePage}" 
                      Route="HomePage"/>
    </FlyoutItem>

    <FlyoutItem Title="Döviz Kurları" Icon="currency.png">
        <ShellContent Title="Döviz Kurları" 
                      ContentTemplate="{DataTemplate local:DovizKurlari}" 
                      Route="DovizKurlari"/>
    </FlyoutItem>

    <FlyoutItem Title="Haberler" Icon="news.png">
        <ShellContent Title="Haberler" 
                      ContentTemplate="{DataTemplate local:NewsPage}" 
                      Route="NewsPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Hava Durumu" Icon="weather.png">
        <ShellContent Title="Hava Durumu" 
                      ContentTemplate="{DataTemplate local:HavaDurumu}" 
                      Route="HavaDurumu"/>
    </FlyoutItem>

    <FlyoutItem Title="Yapılacaklar" Icon="todo.png">
        <ShellContent Title="Yapılacaklar"
                      ContentTemplate="{DataTemplate local:TodoPage}"
                      Route="TodoPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Ayarlar" Icon="settings.png">
        <ShellContent Title="Ayarlar"
                      ContentTemplate="{DataTemplate local:SettingsPage}"
                      Route="SettingsPage"/>
    </FlyoutItem>

    <ShellContent Title="Giriş"
                  ContentTemplate="{DataTemplate local:LoginPage}"
                  Route="LoginPage"
                  IsVisible="False"/>

    <ShellContent Title="Kayıt"
                  ContentTemplate="{DataTemplate local:RegisterPage}"
                  Route="RegisterPage"
                  IsVisible="False"/>

    <ShellContent Title="Todo Detay"
                  ContentTemplate="{DataTemplate local:AddToDoPage}"
                  Route="AddToDoPage"
                  IsVisible="False"/>

</Shell>