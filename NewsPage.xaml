<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:odev3son.Converters"
             x:Class="odev3son.NewsPage"
             Title="Haberler"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid x:Name="loadingOverlay"
              IsVisible="True"
              BackgroundColor="#80000000"
              ZIndex="999">
            <VerticalStackLayout HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Spacing="15">
                <ActivityIndicator IsRunning="True"
                                 Color="White"
                                 HeightRequest="50"
                                 WidthRequest="50"/>
                <Label Text="Haberler yükleniyor..."
                       TextColor="White"
                       FontSize="16"/>
            </VerticalStackLayout>
        </Grid>

        <!-- Main Content -->
        <Grid x:Name="mainContent" 
              IsVisible="False"
              RowDefinitions="Auto,*">

            <!-- Kategori Seçimi -->
            <Frame Grid.Row="0"
                   Margin="10,10,10,5"
                   Padding="10"
                   BackgroundColor="White"
                   CornerRadius="10"
                   HasShadow="True">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Grid.Column="0"
                           Text="📰"
                           FontSize="24"
                           VerticalOptions="Center"
                           Margin="0,0,10,0"/>

                    <Picker Grid.Column="1"
                            x:Name="kategoriPicker"
                            Title="Kategori Seçin"
                            SelectedIndexChanged="KategoriPicker_SelectedIndexChanged"
                            BackgroundColor="Transparent"
                            TextColor="#333333"
                            FontSize="16"
                            VerticalOptions="Center"/>
                </Grid>
            </Frame>

            <!-- Haber Listesi -->
            <RefreshView Grid.Row="1"
                        x:Name="refreshView"
                        Refreshing="RefreshView_Refreshing"
                        RefreshColor="#6200EE">
                <CollectionView x:Name="haberlerCollectionView"
                               SelectionMode="Single"
                               SelectionChanged="HaberSecildi"
                               Margin="10,5,10,10">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Frame Margin="0,0,0,10"
                                   Padding="12"
                                   CornerRadius="12"
                                   BackgroundColor="White"
                                   HasShadow="True">

                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" 
                                      ColumnDefinitions="110,*" 
                                      RowSpacing="8">

                                    <!-- Haber Görseli -->
                                    <Frame Grid.Row="0" 
                                           Grid.Column="0" 
                                           Grid.RowSpan="3"
                                           Padding="0"
                                           CornerRadius="8"
                                           HeightRequest="100"
                                           WidthRequest="100"
                                           HasShadow="False"
                                           BorderColor="#E0E0E0"
                                           IsVisible="{Binding HasImage}">
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"/>
                                    </Frame>

                                    <!-- Placeholder görsel yoksa -->
                                    <Frame Grid.Row="0" 
                                           Grid.Column="0" 
                                           Grid.RowSpan="3"
                                           Padding="0"
                                           CornerRadius="8"
                                           HeightRequest="100"
                                           WidthRequest="100"
                                           BackgroundColor="#E8EAF6"
                                           HasShadow="False"
                                           IsVisible="{Binding HasImage, Converter={StaticResource StringToBoolConverter}}">
                                        <Label Text="📰"
                                               FontSize="40"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"/>
                                    </Frame>

                                    <!-- Haber Başlığı -->
                                    <Label Grid.Row="0" 
                                           Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#212121"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           Margin="10,0,0,0"/>

                                    <!-- Haber Açıklaması -->
                                    <Label Grid.Row="1" 
                                           Grid.Column="1"
                                           Text="{Binding ShortDescription}"
                                           FontSize="13"
                                           TextColor="#616161"
                                           LineBreakMode="WordWrap"
                                           MaxLines="2"
                                           Margin="10,0,0,0"/>

                                    <!-- Tarih -->
                                    <Label Grid.Row="2" 
                                           Grid.Column="1"
                                           Text="{Binding FormattedDate}"
                                           FontSize="11"
                                           TextColor="#9E9E9E"
                                           Margin="10,0,0,0"/>

                                    <!-- Kategori Etiketi -->
                                    <Frame Grid.Row="3"
                                           Grid.Column="0"
                                           Grid.ColumnSpan="2"
                                           Padding="8,4"
                                           CornerRadius="12"
                                           BackgroundColor="#E8EAF6"
                                           HasShadow="False"
                                           HorizontalOptions="Start">
                                        <Label Text="{Binding Category}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="#6200EE"/>
                                    </Frame>

                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Boş liste görünümü -->
                    <CollectionView.EmptyView>
                        <StackLayout HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    Padding="40">
                            <Label Text="📰"
                                   FontSize="60"
                                   HorizontalOptions="Center"
                                   Opacity="0.3"/>
                            <Label Text="Henüz haber yüklenmedi"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#9E9E9E"
                                   HorizontalOptions="Center"
                                   Margin="0,15,0,5"/>
                            <Label Text="Kategori seçerek haberleri görüntüleyin"
                                   FontSize="14"
                                   TextColor="#BDBDBD"
                                   HorizontalOptions="Center"/>
                        </StackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

        </Grid>
    </Grid>
</ContentPage>