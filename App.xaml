<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="odev3son.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Light Theme Colors -->
            <Color x:Key="PrimaryColor">#6200EE</Color>
            <Color x:Key="LightBackground">#FFFFFF</Color>
            <Color x:Key="LightSurface">#F5F5F5</Color>
            <Color x:Key="LightText">#000000</Color>
            <Color x:Key="LightSecondaryText">#666666</Color>

            <!-- Dark Theme Colors -->
            <Color x:Key="DarkBackground">#000000</Color>
            <Color x:Key="DarkSurface">#121212</Color>
            <Color x:Key="DarkText">#FFFFFF</Color>
            <Color x:Key="DarkSecondaryText">#CCCCCC</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>